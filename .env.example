# DramaGenius 前端环境变量
# 复制为 .env.local 使用

# API 基础地址（开发时由 Vite 代理，无需修改）
VITE_API_BASE=/api

# 是否使用真实 API。生产级验证必须为 true。
VITE_USE_REAL_API=true

# 是否允许前端注入内置演示项目/脚本。生产级验证必须为 false。
VITE_ENABLE_DEMO_DATA=false

# 后端百炼 / DashScope 配置（通常写入 backend/.env 或部署环境）
# DASHSCOPE_API_KEY=sk-xxx
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL_MAX=qwen3.5-plus
# QWEN_MODEL_PLUS=qwen3.5-plus
# QWEN_MODEL_TURBO=qwen3.5-plus
# VIDEO_MODEL_DEFAULT=happyhorse-1.0-t2v
# VIDEO_API_BASE=https://dashscope.aliyuncs.com/api/v1
# HAPPYHORSE_T2V_MODEL=happyhorse-1.0-t2v
# HAPPYHORSE_I2V_MODEL=happyhorse-1.0-i2v
# HAPPYHORSE_R2V_MODEL=happyhorse-1.0-r2v
# HAPPYHORSE_EDIT_MODEL=happyhorse-1.0-video-edit
