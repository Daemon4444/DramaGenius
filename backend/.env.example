# DramaGenius 环境变量配置
# 复制此文件为 .env 并填入真实值

# ============ 必填配置 ============

# 通义千问 API Key (从阿里云百炼平台获取)
# https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# JWT 密钥 (生产环境请使用强随机字符串)
JWT_SECRET=dramagenius-dev-secret-key-change-in-production
DEV_SKIP_DB=false
ALLOW_DEMO_DATA=false

# ============ 数据库配置 ============

# PostgreSQL (Docker Compose 默认值)
DATABASE_URL=postgresql+asyncpg://drama:drama123@localhost:5432/dramagenius
DATABASE_SYNC_URL=postgresql+psycopg2://drama:drama123@localhost:5432/dramagenius

# Redis
REDIS_URL=redis://localhost:6379/0

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ES_URL=http://localhost:9200

# ============ 可选配置 ============

# 运行环境: development / staging / production
ENVIRONMENT=development

# CosyVoice 语音合成 (需要单独申请)
COSYVOICE_API_KEY=

# 阿里云 OSS (用于存储音频和导出文件)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=dramagenius
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_PUBLIC_BASE_URL=
OSS_UPLOAD_PREFIX=dramagenius

# 微信登录 (后期功能)
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ============ 限流配置 ============

# API 限流 (每分钟请求数)
RATE_LIMIT_PER_MINUTE=60

# LLM 调用限流 (每分钟)
LLM_RATE_LIMIT_PER_MINUTE=20
